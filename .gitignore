# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
firebase-adminsdk*.json
.env.local
.env

# ── Non-web assets (should never be in a web repo) ────────────────
# Design/marketing documents — use Google Drive or Notion instead
*.docx
*.pptx
*.xlsx
*.pdf

# Instagram / social media content — track in a separate marketing repo
/IG/

# Root-level assets mirror — public/assets/ is the canonical location.
# The root /assets/ folder is a duplicate and bloats the repo by 35 MB.
/assets/

# Cursor IDE project files
.cursor/